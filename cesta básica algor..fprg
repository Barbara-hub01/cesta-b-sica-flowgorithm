<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="cesta b&#225;sica algor."/>
        <attribute name="authors" value="Guilherme Silva"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-31 11:52:48 "/>
        <attribute name="created" value="R3VpbGhlcm1lIFNpbHZhO0RFU0tUT1AtNzk5UEI5UzsyMDI2LTEwLTMxOyIxMTowNzowMCAiOzM2OTA="/>
        <attribute name="edited" value="R3VpbGhlcm1lIFNpbHZhO0RFU0tUT1AtNzk5UEI5UzsyMDI2LTEwLTMxOyIxMTo1Mjo0NyAiOzE7MzgwOQ=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="var1" type="Real" array="False" size=""/>
            <declare name="nome1" type="String" array="False" size=""/>
            <declare name="precoAntigo1" type="Real" array="False" size=""/>
            <declare name="precoAtual1" type="Real" array="False" size=""/>
            <output expression="&quot;Digite o nome do produto:&quot;" newline="True"/>
            <input variable="nome1"/>
            <output expression="&quot;Digite o pre&#231;o no mes anterior:&quot;" newline="True"/>
            <input variable="precoAntigo1"/>
            <output expression="&quot;Digite o pre&#231;o no mes atual:&quot;" newline="True"/>
            <input variable="precoAtual1"/>
            <assign variable="var1" expression="((precoAtual1 - precoAntigo1)/precoAntigo1)*100"/>
            <if expression="precoAtual1&gt;precoAntigo1">
                <then>
                    <output expression="&quot;Status:&#9888;AUMENTO DE PRE&#199;O(poss&#237;vel varia&#231;ao abusiva)&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="precoAtual1&lt;precoAntigo1">
                        <then>
                            <output expression="&quot;Status:&#9989;REDU&#199;&#195;O DE PRE&#199;O&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;Status:&#55357;&#56578;PRE&#199;O MANTIDO&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
